{
  "name": "orun-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "RunCoordinator"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitCounter"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "orun-storage"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orun-db",
      "database_id": "536b10bc-8c63-42e8-bc56-457e636d3a6e",
      "migrations_dir": "../../migrations"
    }
  ],
  "queues": {
    // Producer binding: allows the Worker to enqueue CatalogIngestMessage pointers.
    "producers": [
      {
        "binding": "CATALOG_INGEST_QUEUE",
        "queue": "orun-catalog-ingest"
      }
    ],
    // Consumer: the Worker's queue() export processes CatalogIngestMessage batches.
    // max_batch_size=10 keeps per-message D1 write pressure manageable.
    // max_batch_timeout=30 limits latency for small batches.
    // max_retries=3 gives three attempts before a message goes to the DLQ.
    // dead_letter_queue preserves unprocessable messages for manual inspection.
    "consumers": [
      {
        "queue": "orun-catalog-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "orun-catalog-ingest-dlq"
      }
    ]
  },
  "vars": {
    "GITHUB_JWKS_URL": "https://token.actions.githubusercontent.com/.well-known/jwks",
    "GITHUB_OIDC_AUDIENCE": "orun"
  },
  // V2 Postgres access via Cloudflare Hyperdrive (manually created; do not recreate)
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d8cada8abda7451aaa1e2ce189dc8a17"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RunCoordinator", "RateLimitCounter"]
    }
  ]
}
